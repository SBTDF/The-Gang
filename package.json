{
  "name": "the-gang",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "install:all": "npm ci --include=dev",
    "build": "npm run build --workspace client",
    "build:all": "npm run build --workspace client",
    "test": "node --test server/src/chipRoundRules.test.mjs server/src/gameEngine.challenge.test.mjs server/src/handEvaluator.test.mjs server/src/imposterMode.test.mjs client/src/components/GameTable.challengeVote.test.mjs client/src/components/ImposterPanel.test.mjs",
    "start": "node server/index.js"
  }
}
